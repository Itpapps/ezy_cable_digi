# Uncomment this line to define a global platform for your project 
 platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # ── permission_handler (iOS) ────────────────────────────────────────────
    # Every permission in permission_handler_apple is gated behind a
    # compile-time macro that DEFAULTS TO 0 (see PermissionHandlerEnums.h).
    # With the macro off, the real strategy is replaced at compile time by
    # UnknownPermissionStrategy, whose requestPermission returns
    # PermissionStatusPermanentlyDenied WITHOUT ever calling the iOS API — so
    # no system dialog appears and the permission never shows up in Settings.
    #
    # Only the permissions this app actually requests are enabled; every other
    # macro is left at its 0 default so unused APIs stay out of the binary
    # (keeps App Review surface minimal).
    #
    # Reference: https://github.com/Baseflow/flutter-permission-handler/blob/master/permission_handler_apple/ios/Classes/PermissionHandlerEnums.h
    target.build_configurations.each do |config|
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs + [
        ## dart: PermissionGroup.camera
        # Info.plist: NSCameraUsageDescription
        # Used by: lib/features/scan/scan_customer_screen.dart (mobile_scanner)
        'PERMISSION_CAMERA=1',

        ## dart: [PermissionGroup.location, .locationAlways, .locationWhenInUse]
        # Info.plist: NSLocationWhenInUseUsageDescription,
        #             NSLocationAlwaysAndWhenInUseUsageDescription
        # Used by: lib/features/auth/login_screen.dart,
        #          lib/core/services/real_bluetooth_service.dart
        'PERMISSION_LOCATION=1',

        ## dart: PermissionGroup.notification
        # Used by: lib/core/services/notification_service.dart,
        #          lib/features/auth/login_screen.dart
        'PERMISSION_NOTIFICATIONS=1',

        ## dart: PermissionGroup.bluetooth
        # Info.plist: NSBluetoothAlwaysUsageDescription,
        #             NSBluetoothPeripheralUsageDescription
        # Thermal-printer pairing. NOTE: does NOT affect Permission.bluetoothScan
        # / .bluetoothConnect, which are Android-only permission groups.
        'PERMISSION_BLUETOOTH=1',
      ]
    end
  end
end
